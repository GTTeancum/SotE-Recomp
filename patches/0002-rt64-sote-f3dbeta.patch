+            uint32_t height = 0;
+            uint32_t rowPitch = 0;
+        };
+
+        struct VisibleCaptureState {
+            bool initialized = false;
+            bool enabled = false;
+            std::filesystem::path directory;
+            std::vector<uint64_t> presentIds;
+            size_t nextPresentId = 0;
+        };
+
+        VisibleCaptureState &visibleCaptureState() {
+            static VisibleCaptureState state;
+            if (state.initialized) {
+                return state;
+            }
+
+            state.initialized = true;
+            const char *capturePath = std::getenv("SOTE_VISIBLE_CAPTURE_PATH");
+            const char *capturePresents =
+                std::getenv("SOTE_VISIBLE_CAPTURE_PRESENTS");
+            if ((capturePath == nullptr) || (capturePath[0] == '\0') ||
+                (capturePresents == nullptr) || (capturePresents[0] == '\0')) {
+                return state;
+            }
+
+            const char *cursor = capturePresents;
+            while (*cursor != '\0') {
+                char *end = nullptr;
+                const unsigned long long value =
+                    std::strtoull(cursor, &end, 10);
+                if (end == cursor) {
+                    ++cursor;
+                    continue;
+                }
+                if (value > 0) {
+                    state.presentIds.emplace_back(uint64_t(value));
+                }
+                cursor = end;
+            }
+
+            std::sort(state.presentIds.begin(), state.presentIds.end());
+            state.presentIds.erase(
+                std::unique(state.presentIds.begin(), state.presentIds.end()),
+                state.presentIds.end());
+            if (state.presentIds.empty()) {
+                return state;
+            }
+
+            state.directory = std::filesystem::path(capturePath);
+            std::error_code ec;
+            std::filesystem::create_directories(state.directory, ec);
+            state.enabled = !ec;
+            if (state.enabled) {
+                std::printf(
+                    "[sote][visible-capture] path=%s count=%zu\n",
+                    state.directory.string().c_str(),
+                    state.presentIds.size());
+                std::fflush(stdout);
+            }
+
+            return state;
+        }
+
+        bool shouldCaptureVisible(uint64_t presentId) {
+            VisibleCaptureState &state = visibleCaptureState();
+            if (!state.enabled) {
+                return false;
+            }
+
+            while ((state.nextPresentId < state.presentIds.size()) &&
+                   (state.presentIds[state.nextPresentId] < presentId)) {
+                ++state.nextPresentId;
+            }
+
+            return (state.nextPresentId < state.presentIds.size()) &&
+                (state.presentIds[state.nextPresentId] == presentId);
+        }
+
+        VisibleCapture queueVisibleCapture(
+            RenderDevice *device,
+            RenderCommandList *commandList,
+            RenderTexture *swapChainTexture,
+            uint64_t presentId,
+            uint32_t width,
+            uint32_t height) {
+            VisibleCapture capture;
+            if ((device == nullptr) || (commandList == nullptr) ||
+                (swapChainTexture == nullptr) || (width == 0) ||
+                (height == 0) || !shouldCaptureVisible(presentId)) {
+                return capture;
+            }
+
+            VisibleCaptureState &state = visibleCaptureState();
+            ++state.nextPresentId;
+            const uint32_t rowPitch =
+                ((width * SwapChainBytesPerPixel +
+                    TextureDataPitchAlignment - 1) /
+                    TextureDataPitchAlignment) *
+                TextureDataPitchAlignment;
+            const uint32_t rowWidth = rowPitch / SwapChainBytesPerPixel;
+            const uint64_t byteCount = uint64_t(rowPitch) * height;
+            capture.readbackBuffer =
+                device->createBuffer(RenderBufferDesc::ReadbackBuffer(byteCount));
+            capture.output =
+                state.directory /
+                ("present_" + std::to_string(presentId) + ".ppm");
+            capture.presentId = presentId;
+            capture.width = width;
+            capture.height = height;
+            capture.rowPitch = rowPitch;
+
+            commandList->barriers(
+                RenderBarrierStage::COPY,
+                RenderTextureBarrier(
+                    swapChainTexture,
+                    RenderTextureLayout::COPY_SOURCE));
+            commandList->copyTextureRegion(
+                RenderTextureCopyLocation::PlacedFootprint(
+                    capture.readbackBuffer.get(),
+                    RenderFormat::B8G8R8A8_UNORM,
+                    width,
+                    height,
+                    1,
+                    rowWidth),
+                RenderTextureCopyLocation::Subresource(swapChainTexture));
+
+            return capture;
+        }
+
+        void writeVisibleCapture(const VisibleCapture &capture) {
+            if (capture.readbackBuffer == nullptr || capture.width == 0 ||
+                capture.height == 0 || capture.rowPitch == 0) {
+                return;
+            }
+
+            const uint64_t byteCount =
+                uint64_t(capture.rowPitch) * capture.height;
+            RenderRange readRange = { 0, byteCount };
+            const uint8_t *readbackData =
+                reinterpret_cast<const uint8_t *>(
+                    capture.readbackBuffer->map(0, &readRange));
+            if (readbackData == nullptr) {
+                return;
+            }
+
+            std::ofstream file(capture.output, std::ios::binary);
+            if (!file) {
+                capture.readbackBuffer->unmap();
+                return;
+            }
+
+            file << "P6\n" << capture.width << " " << capture.height
+                 << "\n255\n";
+            uint64_t lavender = 0;
+            uint64_t black = 0;
+            uint64_t white = 0;
+            const uint64_t pixelCount =
+                uint64_t(capture.width) * uint64_t(capture.height);
+            for (uint32_t y = 0; y < capture.height; ++y) {
+                const uint8_t *row =
+                    readbackData + uint64_t(y) * capture.rowPitch;
+                for (uint32_t x = 0; x < capture.width; ++x) {
+                    const uint8_t b = row[x * 4 + 0];
+                    const uint8_t g = row[x * 4 + 1];
+                    const uint8_t r = row[x * 4 + 2];
+                    const uint8_t rgb[3] = { r, g, b };
+                    if (b > r + 8 && b > g + 8 && r > 80 && g > 80) {
+                        ++lavender;
+                    }
+                    if (r < 8 && g < 8 && b < 8) {
+                        ++black;
+                    }
+                    if (r > 248 && g > 248 && b > 248) {
+                        ++white;
+                    }
+                    file.write(reinterpret_cast<const char *>(rgb), 3);
+                }
+            }
+            capture.readbackBuffer->unmap();
+
+            std::printf(
+                "[sote][visible-capture] present=%llu wrote=%s "
+                "size=%ux%u lavender=%.3f%% black=%.3f%% white=%.3f%%\n",
+                static_cast<unsigned long long>(capture.presentId),
+                capture.output.string().c_str(),
+                capture.width,
+                capture.height,
+                double(lavender) * 100.0 / double(pixelCount),
+                double(black) * 100.0 / double(pixelCount),
+                double(white) * 100.0 / double(pixelCount));
+            std::fflush(stdout);
+        }
+    }
