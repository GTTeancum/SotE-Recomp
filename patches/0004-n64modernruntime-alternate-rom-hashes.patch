+// Accepts the canonical hash or any alternate dump the game declares.
+bool check_entry_hash(const std::vector<uint8_t>& rom_data, const recomp::GameEntry& game_entry) {
+    if (check_hash(rom_data, game_entry.rom_hash)) {
+        return true;
+    }
+    for (uint64_t alternate : game_entry.alternate_rom_hashes) {
+        if (check_hash(rom_data, alternate)) {
+            return true;
+        }
+    }
+    return false;
+}
