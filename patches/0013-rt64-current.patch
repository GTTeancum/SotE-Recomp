+        struct BrightnessState {
+            uint32_t width = 0, height = 0;
+            uint32_t columns = 1, rows = 1;
+            std::unique_ptr<RenderTexture> texture;
+            std::unique_ptr<RenderBuffer> histogram, zeros, readback;
+            std::unique_ptr<LuminanceHistogramDescriptorSet> descriptors;
+        };
+        BrightnessState &brightnessState() { static BrightnessState value; return value; }
+        bool queueBrightness(RenderDevice *device, RenderCommandList *list,
+                RenderTexture *output, uint32_t width, uint32_t height,
+                const ShaderLibrary *library, bool supported) {
+            static const bool enabled = std::getenv("SOTE_TRACE_GPU_BRIGHTNESS") != nullptr;
+            static const bool regional = std::getenv("SOTE_TRACE_GPU_BRIGHTNESS_GRID") != nullptr;
+            if (!enabled || !supported || !width || !height) return false;
+            auto &s = brightnessState();
+            if (s.width != width || s.height != height) {
+                s = {};
+                s.columns = regional ? 16 : 1;
+                s.rows = regional ? 9 : 1;
+                const uint32_t bytes = 256 * s.columns * s.rows;
+                s.texture = device->createTexture(RenderTextureDesc::Texture2D(width, height, 1, RenderFormat::B8G8R8A8_UNORM));
+                s.histogram = device->createBuffer(RenderBufferDesc::DefaultBuffer(bytes, RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS));
+                s.zeros = device->createBuffer(RenderBufferDesc::UploadBuffer(bytes));
+                s.readback = device->createBuffer(RenderBufferDesc::ReadbackBuffer(bytes));
+                if (!s.texture || !s.histogram || !s.zeros || !s.readback) { s = {}; return false; }
+                auto *zeros = static_cast<uint32_t *>(s.zeros->map());
+                if (!zeros) { s = {}; return false; }
+                std::fill(zeros, zeros + bytes / 4, 0);
+                s.zeros->unmap();
+                s.descriptors = std::make_unique<LuminanceHistogramDescriptorSet>(device);
+                s.descriptors->setTexture(s.descriptors->HDRTexture, s.texture.get(), RenderTextureLayout::SHADER_READ);
+                s.descriptors->setBuffer(s.descriptors->LuminanceHistogram, s.histogram.get(), bytes);
+                s.width = width; s.height = height;
+            }
+            list->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(output, RenderTextureLayout::COPY_SOURCE));
+            list->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(s.texture.get(), RenderTextureLayout::COPY_DEST));
+            list->copyTexture(s.texture.get(), output);
+            list->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(s.histogram.get(), RenderBufferAccess::WRITE));
+            const uint32_t bytes = 256 * s.columns * s.rows;
+            list->copyBufferRegion(s.histogram.get(), s.zeros.get(), bytes);
+            list->barriers(RenderBarrierStage::COMPUTE, RenderTextureBarrier(s.texture.get(), RenderTextureLayout::SHADER_READ));
+            list->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(s.histogram.get(), RenderBufferAccess::WRITE));
+            struct Constants { uint32_t width, height; float minimum, inverseRange; } constants{width, height, 0.0f, 1.0f};
+            const auto &shader = regional ? library->regionalLuminance : library->luminanceHistogram;
+            list->setPipeline(shader.pipeline.get());
+            list->setComputePipelineLayout(shader.pipelineLayout.get());
+            uint32_t gridConstants[] = {width, height, s.columns, s.rows};
+            list->setComputePushConstants(0, regional ? static_cast<const void *>(gridConstants) : static_cast<const void *>(&constants));
+            list->setComputeDescriptorSet(s.descriptors->get(), 0);
+            list->dispatch(((width + s.columns - 1) / s.columns + 7) / 8,
+                ((height + s.rows - 1) / s.rows + 7) / 8, s.columns * s.rows);
+            list->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(s.histogram.get(), RenderBufferAccess::READ));
+            list->copyBufferRegion(s.readback.get(), s.histogram.get(), bytes);
+            return true;
+        }
+        void logBrightness(uint64_t presentId) {
+            auto &s = brightnessState();
+            RenderRange range{0, 256 * s.columns * s.rows};
+            const auto *regionalBins = static_cast<const uint32_t *>(s.readback->map(0, &range));
+            if (!regionalBins) return;
+            uint32_t bins[64] = {};
+            std::string means, whites;
+            uint32_t invalidCells = 0;
+            for (uint32_t cell = 0; cell < s.columns * s.rows; ++cell) {
+                uint64_t count = 0, weight = 0, white = 0;
+                for (uint32_t i = 0; i < 64; ++i) {
+                    const auto n = regionalBins[cell * 64 + i];
+                    bins[i] += n;
+                    count += n;
+                    if (i) weight += uint64_t(n) * (i - 1);
+                    if (i >= 60) white += n;
+                }
+                const uint32_t cx = cell % s.columns, cy = cell / s.columns;
+                const uint64_t expected = uint64_t((cx + 1) * s.width / s.columns - cx * s.width / s.columns) *
+                    ((cy + 1) * s.height / s.rows - cy * s.height / s.rows);
+                invalidCells += count != expected;
+                if (cell) { means += ','; whites += ','; }
+                means += std::to_string(count ? weight * 10000 / (62 * count) : 0);
+                whites += std::to_string(count ? white * 10000 / count : 0);
+            }
+            uint64_t total = 0, bright = 0, weighted = 0;
+            for (unsigned i = 0; i < 64; ++i) {
+                total += bins[i];
+                if (i >= 60) bright += bins[i];
+                if (i) weighted += uint64_t(bins[i]) * (i - 1);
+            }
+            char header[384];
+            std::snprintf(header, sizeof(header), "[sote][gpu-brightness] present=%llu pixels=%llu expected=%llu black=%u white=%u bright=%llu mean_lower=%.6f bins=",
+                static_cast<unsigned long long>(presentId), static_cast<unsigned long long>(total),
+                static_cast<unsigned long long>(uint64_t(s.width)*s.height), bins[0], bins[63],
+                static_cast<unsigned long long>(bright), total ? double(weighted)/(62.0*total) : 0.0);
+            std::string line(header);
+            for (unsigned i = 0; i < 64; ++i) {
+                if (i) line += ',';
+                line += std::to_string(bins[i]);
+            }
+            std::printf("%s\n", line.c_str());
+            if (s.columns > 1) {
+                std::printf("[sote][gpu-brightness-grid] present=%llu columns=%u rows=%u invalid_cells=%u mean_10000=%s bright_10000=%s\n",
+                    (unsigned long long)presentId, s.columns, s.rows, invalidCells, means.c_str(), whites.c_str());
+            }
+            s.readback->unmap();
+        }
+        constexpr uint32_t SwapChainBytesPerPixel = 4;
+        constexpr uint32_t TextureDataPitchAlignment = 256;
+
+        struct VisibleCapture {
+            std::unique_ptr<RenderBuffer> readbackBuffer;
+            std::filesystem::path output;
+            uint64_t presentId = 0;
+            uint32_t width = 0;
+            uint32_t height = 0;
+            uint32_t rowPitch = 0;
+            bool watch = false;
+        };
+
+        struct VisibleCaptureState {
+            bool initialized = false;
+            bool enabled = false;
+            std::filesystem::path directory;
+            std::vector<uint64_t> presentIds;
+            size_t nextPresentId = 0;
+            unsigned long long watchStart = 0, watchEnd = 0;
+            std::vector<uint8_t> previousPixels;
+            uint64_t previousPresent = 0;
+            double previousWhite = 0, previousMean = 0;
+            unsigned candidates = 0;
+            bool saveNext = false;
+            std::ofstream metrics;
+        };
+
+        VisibleCaptureState &visibleCaptureState() {
+            static VisibleCaptureState state;
+            if (state.initialized) {
+                return state;
+            }
+
+            state.initialized = true;
+            if (const char *watch = std::getenv("SOTE_WHITE_FLASH_WATCH")) {
+                if (std::sscanf(watch, "%llu:%llu", &state.watchStart, &state.watchEnd) != 2)
+                    state.watchStart = state.watchEnd = 0;
+            }
+            const char *capturePath = std::getenv("SOTE_VISIBLE_CAPTURE_PATH");
+            const char *capturePresents =
+                std::getenv("SOTE_VISIBLE_CAPTURE_PRESENTS");
+            if ((capturePath == nullptr) || (capturePath[0] == '\0') ||
+                (capturePresents == nullptr) || (capturePresents[0] == '\0')) {
+                return state;
+            }
+
+            const char *cursor = capturePresents;
+            while (*cursor != '\0') {
+                char *end = nullptr;
+                const unsigned long long value =
+                    std::strtoull(cursor, &end, 10);
+                if (end == cursor) {
+                    ++cursor;
+                    continue;
+                }
+                if (value > 0) {
+                    state.presentIds.emplace_back(uint64_t(value));
+                }
+                cursor = end;
+            }
+
+            std::sort(state.presentIds.begin(), state.presentIds.end());
+            state.presentIds.erase(
+                std::unique(state.presentIds.begin(), state.presentIds.end()),
+                state.presentIds.end());
+            if (state.presentIds.empty()) {
+                return state;
+            }
+
+            state.directory = std::filesystem::path(capturePath);
+            std::error_code ec;
+            std::filesystem::create_directories(state.directory, ec);
+            state.enabled = !ec;
+            if (state.enabled) {
+                std::printf(
+                    "[sote][visible-capture] path=%s count=%zu\n",
+                    state.directory.string().c_str(),
+                    state.presentIds.size());
+                std::fflush(stdout);
+            }
+
+            return state;
+        }
+
+        bool shouldCaptureVisible(uint64_t presentId, bool waitForSubframe) {
+            VisibleCaptureState &state = visibleCaptureState();
+            if (!state.enabled) {
+                return false;
+            }
+            if (state.watchStart && presentId >= state.watchStart && presentId <= state.watchEnd)
+                return true;
+
+            if (waitForSubframe) {
+                return state.nextPresentId < state.presentIds.size() && state.presentIds[state.nextPresentId] <= presentId;
+            }
+            while ((state.nextPresentId < state.presentIds.size()) &&
+                   (state.presentIds[state.nextPresentId] < presentId)) {
+                ++state.nextPresentId;
+            }
+
+            return (state.nextPresentId < state.presentIds.size()) &&
+                (state.presentIds[state.nextPresentId] == presentId);
+        }
+
+        VisibleCapture queueVisibleCapture(
+            int32_t subframe,
+            RenderDevice *device,
+            RenderCommandList *commandList,
+            RenderTexture *swapChainTexture,
+            uint64_t presentId,
+            uint32_t width,
+            uint32_t height,
+            bool supportsReadback) {
+            VisibleCapture capture;
+            static const int32_t selectedSubframe = [] {
+                const char *value = std::getenv("SOTE_VISIBLE_CAPTURE_SUBFRAME");
+                return value ? std::atoi(value) : 0;
+            }();
+            if (selectedSubframe > 0 && selectedSubframe != subframe) return capture;
+            if ((device == nullptr) || (commandList == nullptr) ||
+                (swapChainTexture == nullptr) || (width == 0) ||
+                (height == 0) || !shouldCaptureVisible(presentId, selectedSubframe > 0)) {
+                return capture;
+            }
+
+            VisibleCaptureState &state = visibleCaptureState();
+            capture.watch = state.watchStart && presentId >= state.watchStart && presentId <= state.watchEnd;
+            if (state.nextPresentId < state.presentIds.size() && state.presentIds[state.nextPresentId] <= presentId)
+                ++state.nextPresentId;
+            if (!supportsReadback) {
+                static bool warned = false;
+                if (!warned) {
+                    std::fprintf(stderr, "[sote][capture] Surface does not support readback; skipping native captures.\n");
+                    warned = true;
+                }
+                return capture;
+            }
+            const uint32_t rowPitch =
+                ((width * SwapChainBytesPerPixel +
+                    TextureDataPitchAlignment - 1) /
+                    TextureDataPitchAlignment) *
+                TextureDataPitchAlignment;
+            const uint32_t rowWidth = rowPitch / SwapChainBytesPerPixel;
+            const uint64_t byteCount = uint64_t(rowPitch) * height;
+            capture.readbackBuffer =
+                device->createBuffer(RenderBufferDesc::ReadbackBuffer(byteCount));
+            capture.output =
+                state.directory /
+                ("present_" + std::to_string(presentId) + ".ppm");
+            capture.presentId = presentId;
+            capture.width = width;
+            capture.height = height;
+            capture.rowPitch = rowPitch;
+
+            commandList->barriers(
+                RenderBarrierStage::COPY,
+                RenderTextureBarrier(
+                    swapChainTexture,
+                    RenderTextureLayout::COPY_SOURCE));
+            commandList->copyTextureRegion(
+                RenderTextureCopyLocation::PlacedFootprint(
+                    capture.readbackBuffer.get(),
+                    RenderFormat::B8G8R8A8_UNORM,
+                    width,
+                    height,
+                    1,
+                    rowWidth),
+                RenderTextureCopyLocation::Subresource(swapChainTexture));
+
+            return capture;
+        }
+
+        void writeVisibleCapture(const VisibleCapture &capture) {
+            if (capture.readbackBuffer == nullptr || capture.width == 0 ||
+                capture.height == 0 || capture.rowPitch == 0) {
+                return;
