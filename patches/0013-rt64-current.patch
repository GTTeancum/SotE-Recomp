diff --git a/src/shaders/RegionalLuminanceCS.hlsl b/src/shaders/RegionalLuminanceCS.hlsl
new file mode 100644
index 0000000..495d779
--- /dev/null
+++ b/src/shaders/RegionalLuminanceCS.hlsl
@@ -0,0 +1,31 @@
+// Opt-in presentation diagnostics. Read back regional counters, never pixels.
+#define BINS 64
+struct Constants {
+    uint width;
+    uint height;
+    uint columns;
+    uint rows;
+};
+[[vk::push_constant]] ConstantBuffer<Constants> gConstants : register(b0);
+Texture2D<float3> InputTexture : register(t1);
+RWByteAddressBuffer Histograms : register(u2);
+groupshared uint bins[BINS];
+
+[numthreads(8, 8, 1)]
+void CSMain(uint index : SV_GroupIndex, uint3 tid : SV_DispatchThreadID, uint3 gid : SV_GroupID) {
+    bins[index] = 0;
+    GroupMemoryBarrierWithGroupSync();
+    uint2 cell = uint2(gid.z % gConstants.columns, gid.z / gConstants.columns);
+    uint2 divisions = uint2(gConstants.columns, gConstants.rows);
+    uint2 size = uint2(gConstants.width, gConstants.height);
+    uint2 begin = cell * size / divisions;
+    uint2 end = (cell + 1) * size / divisions;
+    uint2 pixel = begin + tid.xy;
+    if (all(pixel < end)) {
+        float luminance = dot(InputTexture.Load(int3(pixel, 0)), float3(0.2127, 0.7152, 0.0722));
+        uint bin = luminance < 1e-6 ? 0 : uint(saturate(luminance) * 62.0 + 1.0);
+        InterlockedAdd(bins[bin], 1);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    Histograms.InterlockedAdd((gid.z * BINS + index) * 4, bins[index]);
+}
