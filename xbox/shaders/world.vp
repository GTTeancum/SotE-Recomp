!!VP1.1
# c0 raster scale, c1 texture normalization (shared with the screen shader)
# c2..5 model-view columns, c6..9 projection columns
# c10 viewport scale.xyz / perspective UV flag, c11 offset.xyz / affine UV flag
# c12 UV scale.xy / offset.zw, c13 light direction.xyz / input RGB weight
# c14 diffuse.rgb / zero, c15 ambient.rgb / half. Light colors are in bytes.
DP4 R0.x, v[0], c[2];
DP4 R0.y, v[0], c[3];
DP4 R0.z, v[0], c[4];
DP4 R0.w, v[0], c[5];
DP4 R1.x, R0, c[6];
DP4 R1.y, R0, c[7];
DP4 R1.z, R0, c[8];
DP4 R1.w, R0, c[9];
RCP R0.w, R1.w;
MUL R0.xyz, R1, R0.w;
MUL R1.xyz, R0, c[10];
ADD R1.xyz, R1, c[11];
MUL o[HPOS].xyz, R1, c[0];
MOV o[HPOS].w, c[0].w;
MUL R1.w, R0.w, c[10].w;
ADD R1.w, R1.w, c[11].w;
MUL R2.xy, v[8], c[12];
ADD R2.xy, R2, c[12].zwzw;
MUL R2.xy, R2, R1.w;
MUL o[TEX0].xy, R2, c[1];
MOV o[TEX0].z, v[8].z;
MOV o[TEX0].w, R1.w;
DP3 R0.x, v[3], c[13];
MAX R0.x, R0.x, c[14].w;
MUL R0.xyz, R0.x, c[14];
ADD R0.xyz, R0, c[15];
ADD R0.xyz, R0, c[15].w;
# EXP.y is the fractional part. Preserve F3DWAVE's round-to-byte vertex
# lighting before interpolation. COL0 clamps values above one.
EXP R2.y, R0.x;
EXP R3.y, R0.y;
EXP R4.y, R0.z;
ADD R0.x, R0.x, -R2.y;
ADD R0.y, R0.y, -R3.y;
ADD R0.z, R0.z, -R4.y;
MUL R0.xyz, R0, c[1].z;
MAD o[COL0].xyz, v[3], c[13].w, R0;
MOV o[COL0].w, v[3].w;
END
